amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

// Shared Mise check tasks cover Actions, formatting, Python, shell and whitespace.
steps {
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    check = "hk util check-added-large-files --maxkb=1024 {{files}}"
  }
  ["detect-private-key"] = Builtins.detect_private_key
  ["manifests"] = new Step {
    glob = Regex(#"^(apps|clusters|platform|scripts)/"#)
    check = """
      manifest_directory="$(mktemp -d "${TMPDIR:-/tmp}/kubelab-check.XXXXXX")"
      trap 'rm -fr -- "${manifest_directory:?}"' EXIT
      scripts/render_manifests.sh "$manifest_directory"
      # Crossplane functions patch pending.invalid and placeholder.invalid at runtime.
      if grep -rnoE '[[:alnum:]_-]+(\\.[[:alnum:]_-]+)*\\.invalid\\b' "$manifest_directory" |
        grep -vE ':(pending|placeholder)\\.invalid$'; then
        echo "Unresolved placeholders survived rendering" >&2
        exit 1
      fi
      scripts/check_manifests.sh "$manifest_directory"
      scripts/check_service_metadata.sh "$manifest_directory"
      """
  }
}
