.machines as $inventory |
load(strenv(INFRASTRUCTURE)) as $infra |
load(strenv(PROVIDERS)).providers as $providers |
(strenv(HOMEPAGE_CLUSTER_NAMES) | split(",") | map(select(. != ""))) as $cluster_names |
# Tunnel origins and key expiry are noise beside connection health.
($providers.cloudflare // {} | pick(["description", "icon", "name", "widget"]) + {"icon": "sh-cloudflare"} |
  with(select(.widget != null); .widget.fields = ["status"])) as $cloudflare |
($providers.tailscale // {} | pick(["description", "icon", "name", "widget"]) + {"icon": "tailscale-light"} |
  with(select(.widget != null); .widget.fields = ["address", "last_seen"])) as $tailscale |
# Keep inventory fields separate from the derived Homepage presentation.
[$inventory | to_entries[] | .key as $network | .value | to_entries[] |
  .key as $key | .value as $machine | ($machine.hostname // $key) as $hostname |
  {
    "key": $key, "network": $network, "machine": $machine,
    "group": ($network + "-" + $hostname),
    "reference": ("homelab://" + $network + "/" + $key + "/management")
  }
] as $hosts |
($hosts[] as $host ireduce ({}; .[$host.network][$host.key] = $host)) as $host_index |
# Only host management and monitoring appear on Servers; apps keep their categories.
# Grouped providers and services become Home cards; widgets default to the card's URL.
(([$providers[] | select(.group != null) |
  {"description": .description, "icon": .icon, "name": .name, "group": .group,
    "href": .url, "siteMonitor": .url} + pick(["widget"])] +
 [$hosts[] | select(.machine.type != null) | . as $host |
  (.machine.services // {}) | to_entries[] |
  # A grouped management panel also appears in its Home group.
  select(.value.group != null or (.key != "management" and (.value.description != null or .value.icon != null))) |
  ("homelab://" + $host.network + "/" + $host.key + "/" + .key) as $reference |
  {"description": .value.description, "icon": .value.icon, "name": (.value.name // .key), "group": (.value.group // "Infrastructure"),
    "href": $reference, "siteMonitor": (.value.siteMonitor // $reference)} + (.value | pick(["widget"]))]) |
map(with(select(.widget != null); .widget = {"url": .href} + .widget)) |
[.[] |
  (., (select(.group != "Servers" and (.href | test("^homelab://[^/]+/[^/]+/management$"))) | . + {"group": "Servers"})) |
  with(select(.href | test("^homelab://"));
    (.href | sub("^homelab://"; "") | split("/")) as $reference |
    $host_index[$reference[0]][$reference[1]] as $host |
    with(select(.group != "Servers");
      .description = (.description + " • " + $host.group)) |
    with(select(.group == "Servers"); .group = $host.group))]) as $existing |
# Grouped services own their management cards; other hosts get their own.
[$hosts[] | select(.machine.type != null and .machine.services.management != null) |
  select(.reference as $reference | $existing | any_c(.href == $reference) | not) |
  .machine.services.management as $panel |
  {
    "name": ($panel.name // .group), "group": .group,
    "description": $panel.description,
    "icon": $panel.icon,
    "href": .reference, "siteMonitor": ($panel.siteMonitor // .reference)
  }
] as $management |
# Per-host Beszel cards reuse the Beszel route's own Homepage card.
(load(strenv(BESZEL_ROUTES)) as $routes | if ($routes | length) == 1 then
  ($routes[0].annotations | with_entries(select(.key | test("^gethomepage.dev/"))) |
    to_entries | .[] as $field ireduce ({};
      setpath(($field.key | sub("^gethomepage.dev/"; "") | split(".")); ($field.value | sub("^\\{\\{ \"(.*)\" \\}\\}$"; "${1}")))) |
    with(select(.widget.version != null); .widget.version |= from_yaml) |
    pick(["description", "href", "icon", "name", "widget"]))
  else null end) as $beszel |
[$hosts[] | select(.machine.type != null) | . as $host |
  (([.machine] | map(select(.beszel == true)) |
   map(with(select($beszel == null); error("Beszel monitoring needs exactly one Beszel route")) | $beszel + {
    "href": ($beszel.href + "/system/" + $host.group),
    "widget": ($beszel.widget + {"systemId": $host.group, "fields": ["status", "cpu", "memory", "network"]})
  })) +
  ([$infra.tailscale[$host.key]] | map(select(. != null and $tailscale.widget != null)) | map(. as $device | $tailscale + {
    "href": ("https://login.tailscale.com/admin/machines/" + $device),
    "widget": ($tailscale.widget + {"deviceid": $device})
  })) +
  ([$infra.cloudflare.tunnels[$host.key]] | map(select(. != null and $cloudflare.widget != null)) | map(. as $tunnel | $cloudflare + {
    "href": ("https://one.dash.cloudflare.com/" + $infra.cloudflare.account_id + "/networks/connectors/cloudflare-tunnels/cfd_tunnel/" + $tunnel),
    "widget": ($cloudflare.widget + {"accountid": $infra.cloudflare.account_id, "tunnelid": $tunnel})
  }))) | .[] | . + {"group": $host.group}
] as $monitoring |
[($infra.cloudflare.tunnels // {}) | to_entries[] | select($cloudflare.widget != null) |
  .key as $name | select($hosts | any_c(.key == $name) | not) |
  $cloudflare + {"group": $name,
   "href": ("https://one.dash.cloudflare.com/" + $infra.cloudflare.account_id + "/networks/connectors/cloudflare-tunnels/cfd_tunnel/" + .value),
   "widget": ($cloudflare.widget + {"accountid": $infra.cloudflare.account_id, "tunnelid": .value})}
] as $cluster_tunnels |
[($infra.tailscale // {}) | to_entries[] | .key as $name |
  select($cluster_names | contains([$name])) | select($tailscale.widget != null) |
  $tailscale + {"group": $name,
    "href": ("https://login.tailscale.com/admin/machines/" + .value),
    "widget": ($tailscale.widget + {"deviceid": .value})}
] as $cluster_devices |
($existing + $management + $monitoring + $cluster_tunnels + $cluster_devices) |
sort_by(.group, (.name | downcase)) | group_by(.group) |
map({(.[0].group): map(.name as $name | del(.name, .group) | {($name): .})})
