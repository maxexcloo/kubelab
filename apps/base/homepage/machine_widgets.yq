.machines as $inventory |
load(strenv(TEMPLATE)) as $groups |
load(strenv(INFRASTRUCTURE)) as $infra |
[$groups[] | to_entries[] | .key as $group | .value[] | to_entries[] |
  .value + {"name": .key, "group": $group} |
  with(select(.href | test("^homelab://"));
    (.href | sub("^homelab://"; "") | split("/")) as $reference |
    ($inventory[$reference[0]][$reference[1]].hostname // $reference[1]) as $host |
    ($inventory[$reference[0]][$reference[1]].display_name // ($host | split("") | .[0] |= upcase | join(""))) as $hostname |
    .group = ($hostname + " (" + ($reference[0] | upcase) + ")"))] as $existing |
[.machines | to_entries[] | .key as $network | .value | to_entries[] |
  .key as $name | .value as $machine |
  ($machine.hostname // $name) as $hostname |
  ($machine.display_name // ($hostname | split("") | .[0] |= upcase | join(""))) as $display_name |
  ("homelab://" + $network + "/" + $name + "/management") as $management |
  $infra.tailscale[$name] as $device |
  $infra.cloudflare.tunnels[$machine.cluster // $name] as $tunnel |
  {
    "name": ($network + "-" + $hostname),
    "group": ($display_name + " (" + ($network | upcase) + ")"),
    "description": ({"bazzite": "Bazzite", "macos": "macOS", "nanokvm": "NanoKVM",
      "steamos": "SteamOS", "talos": "Talos Linux", "ucore": "uCore"}[$machine.platform] // $machine.platform),
    "icon": ({"bazzite": "linux", "macos": "apple", "steamos": "steam",
      "talos": "talos", "ucore": "linux"}[$machine.platform] // "mdi-server"),
    "reference": $management,
    "href": ([null] + ([$tunnel] | map(select(. != null)) | map("https://one.dash.cloudflare.com/" + $infra.cloudflare.account_id + "/networks/connectors/cloudflare-tunnels/cfd_tunnel/" + .)) +
      ([$machine] | map(select(.beszel == true)) | map(strenv(HOMEPAGE_BESZEL_URL))) +
      ([$device] | map(select(. != null)) | map("https://login.tailscale.com/admin/machines/" + .)) +
      ([$machine] | map(select(.management_port != null)) | map($management)) | .[-1]),
    "widgets": (
      ([$machine] | map(select(.beszel == true and strenv(HOMEPAGE_BESZEL_URL) != "")) | map({
        "type": "beszel", "url": strenv(HOMEPAGE_BESZEL_URL), "version": 2,
        "systemId": ($network + "-" + $hostname),
        "username": "{{HOMEPAGE_FILE_BESZEL_USERNAME}}",
        "password": "{{HOMEPAGE_FILE_BESZEL_PASSWORD}}",
        "fields": ["status", "cpu", "memory", "network"]
      })) +
      ([$device] | map(select(. != null)) | map({
        "type": "tailscale", "deviceid": ., "key": "{{HOMEPAGE_FILE_TAILSCALE_KEY}}"
      })) +
      ([$tunnel] | map(select(. != null)) | map({
        "type": "cloudflared", "accountid": $infra.cloudflare.account_id, "tunnelid": .,
        "key": "{{HOMEPAGE_FILE_CLOUDFLARE_KEY}}"
      }))
    )
  } |
  select($machine.management_port != null or $device != null or $tunnel != null or (.widgets | length > 0))
] as $machines |
($machines | map(select(.href == .reference) | select(.reference as $reference | $existing | any_c(.href == $reference) | not)) | map(del(.widgets))) as $management |
[$machines[] | . as $machine | .widgets[] | . as $widget |
  {
    "name": {"beszel": "Beszel", "cloudflared": "Cloudflare Tunnel", "tailscale": "Tailscale"}[.type],
    "group": $machine.group,
    "description": {"beszel": ($machine.description + " · System Monitoring"), "cloudflared": "Cloudflare Tunnel", "tailscale": "VPN"}[.type],
    "icon": {"beszel": $machine.icon, "cloudflared": "cloudflare", "tailscale": "tailscale"}[.type],
    "href": {"beszel": .url, "cloudflared": ("https://one.dash.cloudflare.com/" + .accountid + "/networks/connectors/cloudflare-tunnels/cfd_tunnel/" + .tunnelid), "tailscale": ("https://login.tailscale.com/admin/machines/" + .deviceid)}[.type],
    "widget": $widget
  }
] as $monitoring |
($existing + $management + $monitoring) |
map(del(.reference) | .weight = 0 | with(select(.widget != null or (.widgets | length > 0)); .weight = -100)) |
sort_by(.group, .weight, .name) | group_by(.group) |
map({(.[0].group): map(.name as $name | del(.name, .group) | {($name): .})})
