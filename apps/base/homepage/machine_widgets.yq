.machines as $inventory |
load(strenv(TEMPLATE)) as $groups |
load(strenv(INFRASTRUCTURE)) as $infra |
(([$groups[] | to_entries[] | .key as $group | .value[] | to_entries[] |
  .value + {"name": .key, "group": $group}] +
 [.machines | to_entries[] | .key as $network | .value | to_entries[] |
  .key as $machine | .value | select(.type != null) |
  (.services // {}) | to_entries[] | select(.value.homepage != null) |
  .value.homepage + {"group": (.value.homepage.group // "Servers"),
    "href": ("homelab://" + $network + "/" + $machine + "/" + .key)}]) |
[.[] |
  (., (select(.group != "Servers" and (.href | test("^homelab://"))) | . + {"group": "Servers"})) |
  with(select(.href | test("^homelab://"));
    (.href | sub("^homelab://"; "") | split("/")) as $reference |
    ($reference[0] + "-" + ($inventory[$reference[0]][$reference[1]].hostname // $reference[1])) as $host |
    ($inventory[$reference[0]][$reference[1]].display_name //
      (($inventory[$reference[0]][$reference[1]].hostname // $reference[1]) | split("") | .[0] |= upcase | join(""))) as $display_name |
    with(select(.group != "Servers");
      .description = (.description + " • " + $display_name + " (" + ($reference[0] | upcase) + ")")) |
    with(select(.group == "Servers"); .group = $host))]) as $existing |
[.machines | to_entries[] | .key as $network | .value | to_entries[] |
  .key as $name | .value as $machine |
  select($machine.type != null) |
  ($machine.hostname // $name) as $hostname |
  ("homelab://" + $network + "/" + $name + "/management") as $management |
  $infra.tailscale[$name] as $device |
  $infra.cloudflare.tunnels[$name] as $tunnel |
  {
    "name": ($network + "-" + $hostname),
    "group": ($network + "-" + $hostname),
    "description": ({"bazzite": "Bazzite", "haos": "Home Assistant OS", "macos": "macOS", "nanokvm": "NanoKVM",
      "steamos": "SteamOS", "talos": "Talos Linux", "truenas": "TrueNAS", "ucore": "uCore", "unifi": "UniFi"}[$machine.platform] // $machine.platform),
    "icon": ({"bazzite": "linux", "haos": "home-assistant", "macos": "apple", "steamos": "steam",
      "talos": "talos", "truenas": "truenas", "ucore": "linux", "unifi": "unifi"}[$machine.platform] // "mdi-server"),
    "panel": ($machine.management // {}),
    "reference": $management,
    "href": $management,
    "management": ($machine.management_port != null),
    "widgets": (
      ([$machine] | map(select(.beszel == true and strenv(HOMEPAGE_BESZEL_URL) != "")) | map({
        "type": "beszel", "url": strenv(HOMEPAGE_BESZEL_URL), "version": 2,
        "systemId": ($network + "-" + $hostname),
        "username": "{{HOMEPAGE_FILE_BESZEL_USERNAME}}",
        "password": "{{HOMEPAGE_FILE_BESZEL_PASSWORD}}",
        "fields": ["status", "cpu", "memory", "network"]
      })) +
      ([$device] | map(select(. != null)) | map({
        "type": "tailscale", "deviceid": ., "key": "{{HOMEPAGE_FILE_TAILSCALE_KEY}}"
      })) +
      ([$tunnel] | map(select(. != null)) | map({
        "type": "cloudflared", "accountid": $infra.cloudflare.account_id, "tunnelid": .,
        "key": "{{HOMEPAGE_FILE_CLOUDFLARE_KEY}}"
      }))
    )
  } |
  select($machine.management_port != null or $device != null or $tunnel != null or (.widgets | length > 0))
] as $machines |
($machines | map(select(.management) | select(.reference as $reference | $existing | any_c(.href == $reference) | not)) |
  map(.name = (.panel.name // .name) |
    .description = (.panel.description // .description) |
    .icon = (.panel.icon // .icon) |
    del(.management, .panel, .widgets))) as $management |
[$machines[] | . as $machine | .widgets[] | . as $widget |
  {
    "name": {"beszel": "Beszel", "cloudflared": "Cloudflare Tunnel", "tailscale": "Tailscale"}[.type],
    "group": $machine.group,
    "description": {"beszel": "System Monitoring", "cloudflared": "Cloudflare Tunnel", "tailscale": "VPN"}[.type],
    "icon": {"beszel": "beszel", "cloudflared": "cloudflare", "tailscale": "tailscale"}[.type],
    "href": {"beszel": (.url + "/system/" + .systemId), "cloudflared": ("https://one.dash.cloudflare.com/" + .accountid + "/networks/connectors/cloudflare-tunnels/cfd_tunnel/" + .tunnelid), "tailscale": ("https://login.tailscale.com/admin/machines/" + .deviceid)}[.type],
    "widget": $widget
  }
] as $monitoring |
[($inventory | .[] | keys | .[]) ] as $machine_names |
[($infra.cloudflare.tunnels // {}) | to_entries[] |
  .key as $name | select($machine_names | any_c(. == $name) | not) |
  {"name": "Cloudflare Tunnel", "group": ("Cluster: " + ($name | upcase)),
   "description": "Cloudflare Tunnel", "icon": "cloudflare",
   "href": ("https://one.dash.cloudflare.com/" + $infra.cloudflare.account_id + "/networks/connectors/cloudflare-tunnels/cfd_tunnel/" + .value),
   "widget": {"type": "cloudflared", "accountid": $infra.cloudflare.account_id,
     "tunnelid": .value, "key": "{{HOMEPAGE_FILE_CLOUDFLARE_KEY}}"}}
] as $cluster_tunnels |
($existing + $management + $monitoring + $cluster_tunnels) |
map(del(.reference) | .weight = 0 | with(select(.widget != null or (.widgets | length > 0)); .weight = -100)) |
sort_by(.group, .weight, .name) | group_by(.group) |
map({(.[0].group): map(.name as $name | del(.name, .group) | {($name): .})})
