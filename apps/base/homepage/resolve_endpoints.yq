load(strenv(INVENTORY)) as $inventory |
load(strenv(INFRASTRUCTURE)) as $infra |
(.. | select(tag == "!!str" and test("^homelab://"))) |= (
  . as $reference |
  capture("^homelab://(?P<network>[a-z0-9-]+)/(?P<machine>[a-z0-9-]+)/(?P<service>[a-z0-9-]+)(?P<suffix>/.*)?$") as $parts |
  $inventory.machines[$parts.machine] as $machine |
  $inventory.services[$parts.machine + "/" + $parts.service] as $service |
  with(select($parts.network == null or $machine.network != $parts.network or $service == null);
    error("Missing or invalid endpoint reference: " + $reference)) |
  {"url": $service.url} |
  with(select($service.dns_lan == true);
    .url |= sub("://[^/:]+"; "://" + $machine.fqdn)) |
  # Published Tailscale hosts are needed for HTTP; HTTPS keeps its certificate DNS.
  with(select($service.hostname == null and $service.scheme == "http" and ($infra.hosts[$parts.machine] // "") != "");
    .url |= sub("^http://[^/:]+"; "http://" + $infra.hosts[$parts.machine])) |
  if ($parts.suffix // "") == "" then .url else
    (.url | sub("/$"; "")) + $parts.suffix end
)
