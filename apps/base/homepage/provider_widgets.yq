.providers.gatus.url as $gatus |
# Flylab's Gatus checks every monitored provider and its DNS resolver; Gatus
# keys endpoints by their lower-case group and name.
[.providers[] | . as $provider |
  (if .monitoring == false then [] else
    [{"probe": .name, "description": (.description // "External Monitoring")}] end) +
  (if .dns == null then [] else
    [{"probe": (.dns.name // (.name + " DNS")), "description": "DNS Resolver"}] end) |
  .[] | . + {"provider": $provider}] |
sort_by(.probe | downcase) |
map(("providers_" + (.probe | downcase | sub("[ /_,.#+&]"; "-"))) as $key | {(.probe): {
  "description": .description,
  "href": (.provider.url // ($gatus + "/endpoints/" + $key)),
  "icon": (.provider.icon // "mdi-cloud"),
  "id": ("provider-" + $key),
  "widget": {
    "type": "customapi",
    "url": ($gatus + "/api/v1/endpoints/" + $key + "/statuses?page=1&pageSize=1"),
    "refreshInterval": 30000,
    "mappings": [
      {"field": "results.0.success", "label": "Status",
       "remap": [{"value": true, "to": "Online"}, {"value": false, "to": "Offline"}, {"any": true, "to": "Unknown"}]},
      {"field": "results.0.duration", "label": "Response", "format": "number", "scale": 0.000001, "suffix": "ms"}
    ]
  }
}}) | [{"Providers": .}]
