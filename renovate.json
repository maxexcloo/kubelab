{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enablePreCommit"],
  "schedule": ["* 0-6 * * 1"],
  "timezone": "Australia/Sydney",
  "customDatasources": {
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://app-updates.agilebits.com/check/1/0/CLI2/en/2.0.0/N",
      "transformTemplates": ["{\"releases\":[{\"version\":version}]}"]
    }
  },
  "customManagers": [
    {
      "currentValueTemplate": "main",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "description": "Update AIOStreams template feeds",
      "managerFilePatterns": ["/apps/base/aiostreams/helm-release\\.yaml$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>Tam-Taro/SEL-Filtering-and-Sorting|Vidhin05/Releases-Regex)/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "Update Crossplane packages",
      "managerFilePatterns": [
        "/platform/automation/crossplane/helm-release\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>xpkg\\.(?:crossplane\\.io|upbound\\.io)/[^:\\s,\\]]+):(?<currentValue>[^\\s,\\]]+)"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "Update database container and extension images",
      "managerFilePatterns": ["/apps/base/.+/database\\.yaml$/"],
      "matchStrings": [
        "(?:imageName|reference):\\s+(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "versioningTemplate": "docker"
    },
    {
      "currentValueTemplate": "main",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "description": "Update Pinned CRD catalogue revision",
      "managerFilePatterns": ["/^scripts/check_manifests\\.sh$/"],
      "matchStrings": [
        "crd_catalog_revision=\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "packageNameTemplate": "https://github.com/datreeio/CRDs-catalog"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "VictoriaMetrics/victorialogs-datasource",
      "description": "Update VictoriaLogs Grafana plugin",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        "/platform/observability/victoria-metrics/helm-release\\.yaml$/"
      ],
      "matchStrings": [
        "victoriametrics-logs-datasource@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "flux": {
    "managerFilePatterns": ["/(^|/).+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/).+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Group non-major development tooling updates",
      "groupName": "development tooling",
      "matchManagers": ["github-actions", "mise", "pre-commit"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "description": "Group patch and digest updates to platform charts",
      "groupName": "platform chart patches",
      "matchFileNames": ["platform/**"],
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["patch", "pin", "digest"]
    },
    {
      "description": "Order Anisette releases by year and month",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dadoum/anisette-v3-server"],
      "versioning": "regex:^(?<minor>\\d{2})-(?<major>\\d{4})$"
    },
    {
      "description": "Read 1Password CLI releases from the official update feed",
      "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      "matchDepNames": ["1password-cli"],
      "matchManagers": ["mise"],
      "overrideDatasource": "custom.onepassword-cli",
      "overridePackageName": "1password-cli"
    }
  ]
}
