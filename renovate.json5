{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>maxexcloo/dotfiles//renovate/default.json5"],
  packageRules: [
    {
      automerge: false,
      description: "Actual Up's @actual-app/api must match the Actual server's major.minor, so release both by hand",
      matchPackageNames: ["docker.io/actualbudget/actual-server"],
    },
    {
      description: "Flux components are upgraded with `flux install --export`",
      enabled: false,
      matchFileNames: ["platform/bootstrap/flux-system/gotk-components.yaml"],
    },
    {
      description: "The Flux CLI image follows the installed Flux version in `gotk-components.yaml`",
      enabled: false,
      matchPackageNames: ["ghcr.io/fluxcd/flux-cli"],
    },
    {
      description: "Kubernetes clients follow the cluster version in Homelab",
      groupName: "Kubernetes Clients",
      matchDepNames: ["docker.io/alpine/k8s", "kubectl"],
    },
    {
      description: "PostgreSQL major upgrades need a data migration",
      enabled: false,
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
    },
    {
      automerge: true,
      description: "Studio releases every verified commit as YYYY.M.D.N; deploy each release without review",
      groupName: "Studio",
      matchPackageNames: ["ghcr.io/maxexcloo/studio", "ghcr.io/maxexcloo/studio-worker"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
    },
    {
      description: "RomM streaming tags prefix the RomM version and add the LinuxServer build",
      matchPackageNames: ["lscr.io/linuxserver/webstation"],
      versioning: "regex:^romm-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$",
    },
    {
      description: "VectorChord images are built per PostgreSQL major, which follows the CloudNativePG cluster",
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"],
      versioning: "regex:^pg18-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "The registry's tag list is incomplete; GitHub releases match published packages",
      matchPackageNames: ["xpkg.upbound.io/crossplane-contrib/provider-http"],
      overrideDatasource: "github-releases",
      overridePackageName: "crossplane-contrib/provider-http",
    },
  ],
}
